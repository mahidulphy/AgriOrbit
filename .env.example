# AgriOrbit Supabase Authentication Environment Variables
# Obtain your project credentials from your Supabase Dashboard:
# https://supabase.com/dashboard/project/_/settings/api

# 1. Project URL (must start with https://)
VITE_SUPABASE_URL=https://your-project.supabase.co

# 2. Public Anon Key (safe for browser distribution; service_role keys must NEVER be exposed here)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
