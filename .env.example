# AgriOrbit Authentication & Environment Configuration

# 1. Supabase Project URL
# - Default: https://your-project.supabase.co
# - With Supabase Custom Domain (Paid Add-on): https://auth.agriorbit.space
VITE_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Public Anon Key (safe for browser; never put service_role key here)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Optional: Google OAuth Client ID (from Google Cloud Console)
# Providing this activates Google Identity Services (GIS) on the frontend.
# The Google consent prompt will display "agri-orbit.vercel.app" instead of "supabase.co".
# Works 100% on the free Supabase tier using signInWithIdToken!
# Example: 1234567890-abcdefg.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
